# ==========================================
# PrediFutbol Engine - Git Ignore Rules
# ==========================================

# 1. Environment & Sensitive Credentials
.env
.env.local
.env.*.local
*.pem
*.key

# 2. Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# 3. Media Exports & Render Artifacts
# Ignore generated MP4 videos and PNG snapshots, but keep the directory
/exports/*
!/exports/.gitkeep

# Ignore temporary audio/TTS files
/public/audio/test_*
/public/audio/temp_*
/public/audio/narration_*

# 4. Legacy PHP / Yii2 Backend (Excluded)
/predifutbolapi/
/vendor/

# 5. OS & Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# 6. Temporary & Scratch Files
scratch/
*.tmp
*.temp
